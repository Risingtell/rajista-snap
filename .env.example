# Copy to .env.local and fill in from your own Firebase project (Project settings > Your apps > Web app),
# with Firebase AI Logic (Gemini Developer API) and App Check (reCAPTCHA Enterprise) turned on. See README.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_RECAPTCHA_SITE_KEY=

# Local testing only: an App Check debug token registered in the Firebase console
# (App Check > Apps > Manage debug tokens). Never commit .env.local.
VITE_APPCHECK_DEBUG_TOKEN=
