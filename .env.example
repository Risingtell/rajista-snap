# Copy to .env.local and fill in from your own Firebase project (Project settings > Your apps > Web app),
# with Firebase AI Logic (Gemini Developer API) and App Check (reCAPTCHA Enterprise) turned on. See README.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_RECAPTCHA_SITE_KEY=

# For local testing only, put this ONE line in a separate file, .env.development.local (never in .env.local):
# VITE_APPCHECK_DEBUG_TOKEN=<an App Check debug token from App Check > Apps > Manage debug tokens>
# It is only used in development mode, and the deploy check refuses any build that contains a token.
